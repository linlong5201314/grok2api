# ============================================================
#  Grok2API 环境变量配置
# ============================================================
# 用法：
#   1. 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会入库）
#   2. 「启动期 / 部署期」变量放这里
#   3. 常规运行时配置优先改 ${DATA_DIR}/config.toml（后台「配置管理」页面）
#
# ⚠ 安全提示：任何含密码/密钥的文件都不要提交到 git。
#    若历史中已泄漏过凭据，请立即全部轮换。

# ==================== 基础运行 ====================
TZ=Asia/Shanghai
LOG_LEVEL=INFO
# 写入本地文件日志
LOG_FILE_ENABLED=true
# 账号目录增量同步间隔（秒）；检测到变化后进入活跃同步 ACCOUNT_SYNC_ACTIVE_INTERVAL
ACCOUNT_SYNC_INTERVAL=30
ACCOUNT_SYNC_ACTIVE_INTERVAL=3


# ==================== Web 服务 ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Granian worker 数量；多 worker 时仅 leader 运行重调度器（Linux fcntl 锁）
SERVER_WORKERS=1

# Docker Compose 宿主机映射端口
HOST_PORT=8000


# ==================== 账号存储（启动期，改后需重启） ====================
# 可选：local | redis | mysql | postgresql
ACCOUNT_STORAGE=local

# local 模式：SQLite 账号库路径
# ACCOUNT_LOCAL_PATH=./data/accounts.db

# redis 模式：Redis DSN（ACCOUNT_STORAGE=redis 时必填）
# ACCOUNT_REDIS_URL=redis://:password@host:6379/0

# mysql 模式：SQLAlchemy DSN
# ACCOUNT_MYSQL_URL=mysql+aiomysql://user:password@127.0.0.1:3306/grok2api

# postgresql 模式：SQLAlchemy DSN
# ACCOUNT_POSTGRESQL_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/grok2api

# SQL 连接池（mysql / postgresql 模式；以下为默认值，一般无需改动）
# ACCOUNT_SQL_POOL_SIZE=5
# ACCOUNT_SQL_MAX_OVERFLOW=10
# ACCOUNT_SQL_POOL_TIMEOUT=30
# ACCOUNT_SQL_POOL_RECYCLE=1800


# ==================== 本地数据 / 日志目录 ====================
DATA_DIR=./data
LOG_DIR=./logs
# local 模式运行时配置文件路径（后台改配置写回这里）
# CONFIG_LOCAL_PATH=./data/config.toml


# ==================== GROK_ 前缀覆盖（可选） ====================
# 任意 config.toml 配置项都可用 GROK_<段>_<键> 环境变量覆盖，
# 例如：
#   GROK_APP_API_KEY=sk-xxx            → 覆盖 app.api_key
#   GROK_APP_APP_KEY=强管理密码        → 覆盖 app.app_key（推荐在此设置）
#   GROK_PROXY_EGRESS_MODE=subscription → 出站模式直接用订阅代理
#   GROK_FEATURES_STREAM=false         → 覆盖 features.stream


# ============================================================
#  首次部署检查清单（详见 README「安全与防识别」章节）：
#   □ 设置强随机 app.app_key（管理面板密码，勿用默认 grok2api）
#   □ 设置强随机 app.api_key（下游 API 密钥）
#   □ 设置 app.app_url（否则图片/视频外链可能 403）
#   □ 面板端口勿裸暴露公网，置于反代之后并加访问控制
# ============================================================
